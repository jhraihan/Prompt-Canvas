# Editor defaults for Prompt Canvas.
# https://editorconfig.org -- supported natively by most editors.
#
# These match the tools that enforce them: ruff (backend) and oxlint/prettier
# conventions (frontend). Where the two disagree, the tool wins -- this file
# exists so an editor does not fight the formatter in the first place.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff: line-length 90, 4-space indent.
[*.py]
indent_size = 4
max_line_length = 90

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
# Recipe lines must begin with a real tab.
indent_style = tab

[*.{sh,bash}]
indent_size = 2

# Windows batch files require CRLF.
[*.{bat,cmd}]
end_of_line = crlf
