# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DJANGO_ALLOWED_HOSTS=prompt-canvas.devtechguru.cloud

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/promptcanvas

# --- Hugging Face ---------------------------------------------------------
# Create at https://huggingface.co/settings/tokens (a read token is enough).
# NEVER commit the real value and never expose it to the React client.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=black-forest-labs/FLUX.1-schnell
HF_PROVIDER=auto
HF_TIMEOUT=120

# --- Frontend origin ------------------------------------------------------
# Exact scheme + host, no trailing slash, comma separated.
# This is a SECURITY CONTROL, not just convenience: the cookie-authenticated
# refresh and logout endpoints validate the request Origin against this list.
# Never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production: CORS_ALLOWED_ORIGINS=https://prompt-canvas.technicalbind.com

# --- Provider / storage selection ----------------------------------------
# IMAGE_PROVIDER: huggingface | stub   (stub generates offline placeholders)
IMAGE_PROVIDER=huggingface
IMAGE_STORAGE=local

# Absolute origin for image URLs, so the Vercel frontend can load them.
# Leave empty in development: dev settings fall back to http://localhost:8000,
# because a relative /media/ URL would resolve against the Vite dev server.
MEDIA_BASE_URL=
# Production: MEDIA_BASE_URL=https://prompt-canvas.devtechguru.cloud

# --- Rate limits ----------------------------------------------------------
GENERATION_RATE=20/hour
ANON_RATE=30/hour
USER_RATE=300/hour

# Credential endpoints have their own budgets so that sign-up traffic cannot
# spend the allowance meant to slow password guessing. LOGIN_RATE is the
# brute-force control: keep it low.
LOGIN_RATE=10/hour
REGISTER_RATE=10/hour
# Refresh and logout: unauthenticated POSTs that write to the database.
TOKEN_RATE=60/hour

# --- Email ----------------------------------------------------------------
# Password reset and email verification. Any SMTP provider works -- Gmail,
# Brevo, Mailgun, SES, Postmark. Development overrides the backend to the
# console, so the reset link prints to your terminal and none of this is
# needed locally.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Must be an address the SMTP provider has authorised you to send from.
DEFAULT_FROM_EMAIL=Prompt Canvas <noreply@example.com>

# Where emailed links point: the SPA owns /reset-password and /verify-email.
# Defaults to the first CORS_ALLOWED_ORIGINS entry when empty.
FRONTEND_BASE_URL=

# Link lifetimes, in seconds.
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=259200

# Reset requests send mail to a caller-supplied address: keep this tight.
PASSWORD_RESET_RATE=5/hour

# --- Observability --------------------------------------------------------
# JSON logs suit a log aggregator; set False for readable output in a terminal.
LOG_JSON=True

# Error tracking is entirely optional. Leave SENTRY_DSN empty and nothing is
# initialised and nothing is sent. Request bodies, headers, and cookies are
# scrubbed before any event leaves this server -- see config/observability.py.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
